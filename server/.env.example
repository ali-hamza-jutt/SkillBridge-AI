# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# Local:         mongodb://localhost:27017/marketplace
MONGODB_URI=mongodb://localhost:27017/marketplace

# ── Cache ─────────────────────────────────────────────────────────────────────
# Upstash Redis: rediss://default:<password>@<host>:<port>
# Local:         redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Message Broker ────────────────────────────────────────────────────────────
# CloudAMQP:  amqps://<user>:<password>@<host>/<vhost>
# Local:      amqp://localhost:5672
RABBITMQ_URL=amqp://localhost:5672

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@yourapp.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Google Cloud Storage ──────────────────────────────────────────────────────
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
# Paste the entire service account JSON as a single-line string
GCS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Cloudinary (optional, server-side uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Zoom (Server-to-Server OAuth app, Marketplace) ────────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Secret Token from the Zoom app's Event Subscriptions configuration
ZOOM_WEBHOOK_SECRET_TOKEN=
